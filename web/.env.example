# -----------------------------------------------------------------------------
# Pickleball Frontend (Next.js) Environment Variables Template
# Copy this file to '.env.local' in the same folder and configure values.
# -----------------------------------------------------------------------------

# Backend API URLs
# ----------------
# NEXT_PUBLIC_API_BASE_URL is the primary endpoint for backend API requests.
# Payment returns stay same-origin at /booking/redirect; the page verifies
# server-to-server, so this value is never used for a browser payment redirect.
# Default for local development: http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000


# Map Integration
# ---------------
# MapTiler API Key for rendering interactive court maps on the frontend.
# Obtain a key by signing up at: https://www.maptiler.com/
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_api_key_here


# PhonePe Payment Gateway Config
# ------------------------------
# Controls which PhonePe JS bundle checkouts load.
# Options: SANDBOX, PRODUCTION
NEXT_PUBLIC_PHONEPE_ENV=SANDBOX


# Security
# --------
# COOKIE_SECURE forces the `Secure` cookie flag on/off. Leave unset to derive it
# automatically (Secure everywhere except local development). Set to "true" on any
# HTTPS staging/preview deploy whose NODE_ENV is not "production".
# COOKIE_SECURE=true
#
# SERVER_ACTIONS_ALLOWED_ORIGINS restricts Server Action invocation to trusted
# origins when the app is deployed behind a proxy domain (comma-separated hosts).
# SERVER_ACTIONS_ALLOWED_ORIGINS=app.baselinearena.in
