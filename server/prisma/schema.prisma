generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CourtEnvironment {
  indoor
  outdoor
}

enum CourtStatus {
  active
  maintenance
  offline
}

enum StaffStatus {
  pending_activation
  active
  suspended
  locked
}

enum AuthSessionStatus {
  active
  revoked
  expired
}

enum OtpPurpose {
  customer_login
}

enum ScheduleExceptionType {
  closed
  modified_hours
  blocked
}

enum DiscountType {
  flat
  percentage
}

enum BookingStatus {
  pending_payment
  confirmed
  expired
  cancelled
  walk_in
  admin_block
}

enum BookingType {
  online
  walk_in
  admin_block
}

enum PaymentGateway {
  phonepe
  wallet
}

enum PaymentStatus {
  initiated
  success
  failed
  refund_pending
  refunded
  refund_failed
}

enum WalletTransactionType {
  credit_issued
  credit_redeemed
}

enum RewardMechanismType {
  scratch_card
  spinner
  coupon_drop
  points
}

enum RewardTriggerEvent {
  booking_confirmed
}

enum RewardInstanceStatus {
  pending
  revealed
  expired
}

enum PrizeType {
  no_prize
  wallet_credit
  coupon
  free_booking
}

enum FulfillmentStatus {
  pending
  fulfilled
  not_applicable
  failed
}

model Venue {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String              @db.VarChar(255)
  slug               String              @unique @db.VarChar(100)
  address            String
  city               String              @db.VarChar(100)
  timezone           String              @db.VarChar(50)
  currency           String              @default("INR") @db.Char(3)
  rolloverTime       DateTime            @map("rollover_time") @db.Time
  advanceBookingDays Int                 @default(7) @map("advance_booking_days") @db.SmallInt
  phone              String?             @db.VarChar(20)
  secondaryPhone     String?             @map("secondary_phone") @db.VarChar(20)
  email              String?             @db.VarChar(255)
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(6)
  courts             Court[]
  roles              VenueUserRole[]
  schedules          Schedule[]
  scheduleExceptions ScheduleException[]
  pricingRules       PricingRule[]
  coupons            Coupon[]
  bookings           Booking[]
  reviews            Review[]
  rewardMechanisms   RewardMechanism[]

  @@index([isActive])
  @@map("venues")
}

model Court {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId            String              @map("venue_id") @db.Uuid
  name               String              @db.VarChar(100)
  surfaceType        String?             @map("surface_type") @db.VarChar(50)
  environment        CourtEnvironment
  description        String?
  coverImageUrl      String?             @map("cover_image_url") @db.VarChar(500)
  status             CourtStatus         @default(active)
  displayOrder       Int                 @default(0) @map("display_order") @db.SmallInt
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(6)
  venue              Venue               @relation(fields: [venueId], references: [id], onDelete: Restrict)
  schedules          Schedule[]
  scheduleExceptions ScheduleException[]
  pricingRules       PricingRule[]
  basePrice          BasePrice?
  bookingSlots       BookingSlot[]

  @@index([venueId, status, displayOrder])
  @@map("courts")
}

model User {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone                 String?             @unique @db.VarChar(20)
  name                  String?             @db.VarChar(255)
  isPhoneVerified       Boolean             @default(false) @map("is_phone_verified")
  onboardingCompletedAt DateTime?           @map("onboarding_completed_at") @db.Timestamptz(6)
  walletCredits         Decimal             @default(0) @map("wallet_credits") @db.Decimal(10, 2)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?           @map("deleted_at") @db.Timestamptz(6)
  venueRoles            VenueUserRole[]     @relation("UserVenueRoles")
  assignedRoles         VenueUserRole[]     @relation("AssignedVenueRoles")
  staffCredential       StaffCredential?
  createdStaff          StaffCredential[]   @relation("StaffCreatedBy")
  sessions              AuthSession[]
  refreshTokens         RefreshToken[]
  bookings              Booking[]
  couponUsages          CouponUsage[]
  walletTransactions    WalletTransaction[]
  reviews               Review[]
  rewardInstances       RewardInstance[]
  scheduleExceptions    ScheduleException[] @relation("ScheduleExceptionCreatedBy")

  @@index([name])
  @@map("users")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique @db.VarChar(50)
  description String?
  permissions RolePermission[]
  venueUsers  VenueUserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique @db.VarChar(100)
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model VenueUserRole {
  userId     String   @map("user_id") @db.Uuid
  venueId    String   @map("venue_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?  @map("assigned_by") @db.Uuid
  user       User     @relation("UserVenueRoles", fields: [userId], references: [id], onDelete: Cascade)
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assigner   User?    @relation("AssignedVenueRoles", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([userId, venueId])
  @@index([venueId, roleId])
  @@map("venue_user_roles")
}

model StaffCredential {
  id                       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String      @unique @map("user_id") @db.Uuid
  email                    String      @unique @db.VarChar(255)
  passwordHash             String?     @map("password_hash")
  status                   StaffStatus @default(pending_activation)
  activationTokenHash      String?     @map("activation_token_hash")
  activationTokenExpiresAt DateTime?   @map("activation_token_expires_at") @db.Timestamptz(6)
  passwordResetTokenHash   String?     @map("password_reset_token_hash")
  passwordResetExpiresAt   DateTime?   @map("password_reset_expires_at") @db.Timestamptz(6)
  failedLoginAttempts      Int         @default(0) @map("failed_login_attempts") @db.SmallInt
  lockedUntil              DateTime?   @map("locked_until") @db.Timestamptz(6)
  forcePasswordChange      Boolean     @default(false) @map("force_password_change")
  lastLoginAt              DateTime?   @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp              String?     @map("last_login_ip") @db.Inet
  passwordChangedAt        DateTime?   @map("password_changed_at") @db.Timestamptz(6)
  createdBy                String?     @map("created_by") @db.Uuid
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?   @map("deleted_at") @db.Timestamptz(6)
  user                     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator                  User?       @relation("StaffCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("staff_credentials")
}

model OtpRequest {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone        String      @db.VarChar(20)
  purpose      OtpPurpose  @default(customer_login)
  otpHash      String      @map("otp_hash")
  expiresAt    DateTime    @map("expires_at") @db.Timestamptz(6)
  verifiedAt   DateTime?   @map("verified_at") @db.Timestamptz(6)
  attemptCount Int         @default(0) @map("attempt_count") @db.SmallInt
  ipAddress    String?     @map("ip_address") @db.Inet
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_requests")
}

model AuthSession {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  status        AuthSessionStatus @default(active)
  ipAddress     String?           @map("ip_address") @db.Inet
  userAgent     String?           @map("user_agent")
  lastSeenAt    DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt     DateTime          @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?         @map("revoked_at") @db.Timestamptz(6)
  revokeReason  String?           @map("revoke_reason") @db.VarChar(100)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, status])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String       @map("session_id") @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  tokenHash         String       @unique @map("token_hash")
  parentTokenId     String?      @map("parent_token_id") @db.Uuid
  replacedByTokenId String?      @map("replaced_by_token_id") @db.Uuid
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  session           AuthSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, revokedAt])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Schedule {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId          String   @map("venue_id") @db.Uuid
  courtId          String   @map("court_id") @db.Uuid
  dayOfWeek        Int[]    @map("day_of_week")
  openTime         DateTime @map("open_time") @db.Time
  closeTime        DateTime @map("close_time") @db.Time
  slotDurationMins Int      @default(60) @map("slot_duration_mins") @db.SmallInt
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  venue            Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  court            Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([venueId, courtId, isActive])
  @@map("schedules")
}

model ScheduleException {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId       String                @map("venue_id") @db.Uuid
  courtId       String?               @map("court_id") @db.Uuid
  exceptionDate DateTime              @map("exception_date") @db.Date
  exceptionType ScheduleExceptionType @map("exception_type")
  openTime      DateTime?             @map("open_time") @db.Time
  closeTime     DateTime?             @map("close_time") @db.Time
  reason        String?
  createdBy     String?               @map("created_by") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  venue         Venue                 @relation(fields: [venueId], references: [id], onDelete: Cascade)
  court         Court?                @relation(fields: [courtId], references: [id], onDelete: Cascade)
  creator       User?                 @relation("ScheduleExceptionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([venueId, exceptionDate])
  @@index([courtId, exceptionDate])
  @@map("schedule_exceptions")
}

model PricingRule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  courtId   String?  @map("court_id") @db.Uuid
  name      String   @db.VarChar(255)
  rule      Json
  priority  Int      @default(0) @db.SmallInt
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  court     Court?   @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([venueId, isActive, priority])
  @@map("pricing_rules")
}

model BasePrice {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courtId   String   @unique @map("court_id") @db.Uuid
  amount    Decimal  @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@map("base_prices")
}

model Coupon {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId         String?       @map("venue_id") @db.Uuid
  code            String        @unique @db.VarChar(50)
  discountType    DiscountType  @map("discount_type")
  discountValue   Decimal       @map("discount_value") @db.Decimal(10, 2)
  maxUsesTotal    Int?          @map("max_uses_total")
  maxUsesPerPhone Int           @default(1) @map("max_uses_per_phone") @db.SmallInt
  validFrom       DateTime?     @map("valid_from") @db.Timestamptz(6)
  validUntil      DateTime?     @map("valid_until") @db.Timestamptz(6)
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  venue           Venue?        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  usages          CouponUsage[]

  @@index([venueId, isActive])
  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  phone     String   @db.VarChar(20)
  usedAt    DateTime @default(now()) @map("used_at") @db.Timestamptz(6)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId, phone])
  @@map("coupon_usages")
}

model Booking {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId             String              @map("venue_id") @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  slotDate            DateTime            @map("slot_date") @db.Date
  sessionStartTime    DateTime            @map("session_start_time") @db.Time
  sessionEndTime      DateTime            @map("session_end_time") @db.Time
  sessionDurationMins Int                 @map("session_duration_mins") @db.SmallInt
  courtCount          Int                 @map("court_count") @db.SmallInt
  slotUnitCount       Int                 @map("slot_unit_count") @db.SmallInt
  status              BookingStatus       @default(pending_payment)
  bookingType         BookingType         @default(online) @map("booking_type")
  baseAmount          Decimal             @map("base_amount") @db.Decimal(10, 2)
  discountAmount      Decimal             @default(0) @map("discount_amount") @db.Decimal(10, 2)
  taxAmount           Decimal             @default(0) @map("tax_amount") @db.Decimal(10, 2)
  totalAmount         Decimal             @map("total_amount") @db.Decimal(10, 2)
  creditsApplied      Decimal             @default(0) @map("credits_applied") @db.Decimal(10, 2)
  couponId            String?             @map("coupon_id") @db.Uuid
  expiresAt           DateTime?           @map("expires_at") @db.Timestamptz(6)
  waiverAccepted      Boolean             @default(false) @map("waiver_accepted")
  waiverAcceptedAt    DateTime?           @map("waiver_accepted_at") @db.Timestamptz(6)
  waiverIpAddress     String?             @map("waiver_ip_address") @db.Inet
  accessPin           String?             @map("access_pin") @db.Char(4)
  notes               String?
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  venue               Venue               @relation(fields: [venueId], references: [id], onDelete: Restrict)
  user                User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon              Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  slots               BookingSlot[]
  payments            Payment[]
  walletTransactions  WalletTransaction[]
  couponUsages        CouponUsage[]
  review              Review?
  rewardInstances     RewardInstance[]

  @@index([status, expiresAt])
  @@index([userId, status])
  @@index([venueId, slotDate])
  @@map("bookings")
}

model BookingSlot {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId     String        @map("booking_id") @db.Uuid
  courtId       String        @map("court_id") @db.Uuid
  slotDate      DateTime      @map("slot_date") @db.Date
  slotStartTime DateTime      @map("slot_start_time") @db.Time
  slotEndTime   DateTime      @map("slot_end_time") @db.Time
  status        BookingStatus
  unitPrice     Decimal       @map("unit_price") @db.Decimal(10, 2)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  court         Court         @relation(fields: [courtId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([courtId, slotDate])
  @@map("booking_slots")
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String        @map("booking_id") @db.Uuid
  gateway           PaymentGateway @default(phonepe)
  merchantOrderId   String?       @unique @map("merchant_order_id") @db.VarChar(255)
  gatewayOrderId    String?       @map("gateway_order_id") @db.VarChar(255)
  gatewayPaymentId  String?       @map("gateway_payment_id") @db.VarChar(255)
  upiVpa            String?       @map("upi_vpa") @db.VarChar(255)
  paymentMode       String?       @map("payment_mode") @db.VarChar(30)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR") @db.Char(3)
  status            PaymentStatus @default(initiated)
  webhookReceivedAt DateTime?     @map("webhook_received_at") @db.Timestamptz(6)
  idempotencyKey    String?       @unique @map("idempotency_key") @db.VarChar(255)
  merchantRefundId  String?       @unique @map("merchant_refund_id") @db.VarChar(255)
  refundAmount      Decimal?      @map("refund_amount") @db.Decimal(10, 2)
  refundInitiatedAt DateTime?     @map("refund_initiated_at") @db.Timestamptz(6)
  refundCompletedAt DateTime?     @map("refund_completed_at") @db.Timestamptz(6)
  rawWebhookPayload  Json?         @map("raw_webhook_payload")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model WalletTransaction {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  bookingId    String?               @map("booking_id") @db.Uuid
  type         WalletTransactionType
  amount       Decimal               @db.Decimal(10, 2)
  balanceAfter Decimal               @map("balance_after") @db.Decimal(10, 2)
  reason       String?
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking      Booking?              @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

model Review {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String   @unique @map("booking_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  venueId     String   @map("venue_id") @db.Uuid
  rating      Int      @db.SmallInt
  comment     String?
  photoUrl    String?  @map("photo_url") @db.VarChar(500)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, isPublished, createdAt])
  @@map("reviews")
}

model RewardMechanism {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId            String                @map("venue_id") @db.Uuid
  name               String                @db.VarChar(255)
  type               RewardMechanismType
  triggerEvent       RewardTriggerEvent    @default(booking_confirmed) @map("trigger_event")
  config             Json
  instanceExpiryDays Int                   @default(7) @map("instance_expiry_days") @db.SmallInt
  isActive           Boolean               @default(false) @map("is_active")
  validFrom          DateTime?             @map("valid_from") @db.Timestamptz(6)
  validUntil         DateTime?             @map("valid_until") @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?             @map("deleted_at") @db.Timestamptz(6)
  venue              Venue                 @relation(fields: [venueId], references: [id], onDelete: Cascade)
  instances          RewardInstance[]

  @@index([venueId, isActive, triggerEvent])
  @@map("reward_mechanisms")
}

model RewardInstance {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mechanismId       String               @map("mechanism_id") @db.Uuid
  mechanismType     RewardMechanismType  @map("mechanism_type")
  userId            String               @map("user_id") @db.Uuid
  bookingId         String               @map("booking_id") @db.Uuid
  status            RewardInstanceStatus @default(pending)
  configSnapshot    Json                 @map("config_snapshot")
  outcome           Json
  prizeType         PrizeType            @map("prize_type")
  prizeValue        Decimal?             @map("prize_value") @db.Decimal(10, 2)
  revealedAt        DateTime?            @map("revealed_at") @db.Timestamptz(6)
  expiresAt         DateTime             @map("expires_at") @db.Timestamptz(6)
  fulfillmentStatus FulfillmentStatus    @default(pending) @map("fulfillment_status")
  fulfillmentNote   String?              @map("fulfillment_note")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  mechanism         RewardMechanism      @relation(fields: [mechanismId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking           Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, mechanismId])
  @@index([userId, status])
  @@map("reward_instances")
}
