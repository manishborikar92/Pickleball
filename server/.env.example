NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_NAME="Pickleball Platform API"
API_PREFIX=/api/v1
LOG_LEVEL=info
TRUST_PROXY=1

# Comma-separated browser origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_CREDENTIALS=false

JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Use a long, unique secret in every environment.
JWT_ACCESS_SECRET=replace_with_64_plus_random_chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=replace_with_different_64_plus_random_chars
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=baseline-api
JWT_AUDIENCE=baseline-web

# PostgreSQL is the only application database.
DATABASE_ENABLED=true
DATABASE_URL=postgresql://postgres:password@localhost:5432/pickleball

# OTP modes: sandbox, test, production.
# sandbox always uses 123456. test uses OTP_TEST_CODE. production sends through WhatsApp.
OTP_MODE=sandbox
OTP_TEST_CODE=123456
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

REFRESH_COOKIE_NAME=pb_refresh_token
REFRESH_COOKIE_DOMAIN=


# Required only when OTP_MODE=production.
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US

SHUTDOWN_TIMEOUT_MS=10000
