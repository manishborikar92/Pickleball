            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "bookings",
            ":bookingId",
            "initiate-payment"
          ],
          "variable": [
            {
              "key": "bookingId",
              "value": ""
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"use_wallet_credits\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
