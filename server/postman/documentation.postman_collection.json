    "description": "Documentation endpoints."
  },
  "item": [
    {
      "name": "OpenAPI JSON specification",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/docs/openapi.json",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "docs",
            "openapi.json"
          ]
        }
      }
    },
    {
      "name": "Swagger UI",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/docs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "docs"
          ]
        }
      }
    }
  ],
  "variable": [
