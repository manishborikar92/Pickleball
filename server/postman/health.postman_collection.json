{
  "info": {
    "name": "Health",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Health endpoints."
  },
  "item": [
    {
      "name": "Service health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ]
        }
      }
    },
    {
      "name": "Liveness probe",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/live",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "live"
          ]
        }
      }
    },
    {
      "name": "Readiness probe",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/ready",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "ready"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ]
}
